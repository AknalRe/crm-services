# Database PostgreSQL
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password
POSTGRES_DB=crm_db
POSTGRES_PORT=5432

# Redis Queue
REDIS_PORT=6379

# WAHA (WhatsApp HTTP API)
WAHA_PORT=3000
# Gunakan http://waha:3000 jika menggunakan container bawaan,
# Atau ganti dengan domain/URL service Reneo Anda (misal: https://wa.reneo.id)
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=
WAHA_SESSION=default

# Backend API
BACKEND_PORT=5000

# Frontend Web Dashboard
FRONTEND_PORT=8080

